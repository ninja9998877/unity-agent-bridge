# 统一换行符，避免不同平台 clone 出来整文件 diff
* text=auto

# Unity 的 C# 脚本保持 CRLF（跟 Unity 生成的保持一致）
*.cs    text eol=crlf

# 其它文本用 LF
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.meta  text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制
*.png   binary
*.jpg   binary
*.dll   binary
*.so    binary
*.dylib binary
